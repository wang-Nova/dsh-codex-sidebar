{
  "name": "dsh-codex-sidebar",
  "version": "0.1.0",
  "description": "DeepSeek Harness Codex 风格独立导航栏与侧栏插件（保留原生对话区）",
  "type": "module",
  "main": "lib/host.js",
  "exports": {
    ".": "./lib/host.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node test-skills-host.mjs && node test-skills-controller.cjs"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "skin.json",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "THIRD_PARTY_NOTICES.md",
    "licenses",
    "package.json"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "codex",
    "sidebar",
    "plugin",
    "ui"
  ],
  "author": "wang-Nova",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wang-Nova/dsh-codex-sidebar.git"
  },
  "homepage": "https://github.com/wang-Nova/dsh-codex-sidebar#readme",
  "bugs": {
    "url": "https://github.com/wang-Nova/dsh-codex-sidebar/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-model-selection",
        "@deepseek-ai/dsh-client-ui-permission-presets",
        "@deepseek-ai/dsh-client-ui-settings-general",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-client-store": "*"
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.1-rc.2 <0.3.0-0"
  }
}
